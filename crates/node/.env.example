# Required P2P configuration. NETWORK_ID must be exactly 32 bytes of hex.
NETWORK_ID=1111111111111111111111111111111111111111111111111111111111111111
NODE_ADDR=127.0.0.1:5000
# Each local node process needs a different directory and therefore a different identity.
NODE_DATA_DIR=/tmp/cubecoin/bootstrap

# Omit both values for the bootstrap node. Other local nodes pin its stable NodeId.
# BOOTSTRAP_ADDR=127.0.0.1:5000
# BOOTSTRAP_NODE_ID=<64 hexadecimal characters printed by bootstrap on startup>

# Logging
# Supports tracing filter directives, for example: cubecoin_node=debug,envy=warn
RUST_LOG=info
# pretty, compact, or json; defaults to pretty for the node
LOG_FORMAT=pretty
