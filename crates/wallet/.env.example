# Logging
# Supports tracing filter directives, for example: cubecoin_wallet=debug
RUST_LOG=info
# pretty, compact, or json; defaults to compact for the wallet
LOG_FORMAT=compact

# Debug builds only: override the Linux XDG wallet path with an absolute path.
CUBECOIN_WALLET_DEV_PATH=/absolute/path/to/crates/wallet/identity/wallet.bin
